Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
RewriteBase /

RewriteCond %{HTTPS} off
RewriteRule ^ https://tony.aiello.io%{REQUEST_URI} [R=301,L]

# Old build files remain in the shared webspace after SFTP uploads. Retire the
# former bundle paths and withdrawn photos even when those files still exist.
RewriteRule ^(?:js|css)/[^/]+\.[0-9a-f]{8,}\.(?:js|css)(?:\.map)?$ - [G,L,NC]
RewriteRule ^img/[^/]+\.[0-9a-f]{8,}\.(?:png|jpe?g|gif|webp|svg)$ - [G,L,NC]
RewriteRule ^media/(?:anthony-aiello-faculty|app-factory|radar-add-course|radar-course-list|radar-edit-account)\.webp$ - [G,L,NC]
RewriteRule ^assets/(?:js|css)/ - [G,L,NC]
RewriteRule ^projects/(?:rainbow-of-dreams|chi-steppin)(?:/index\.html|/)?$ - [G,L,NC]
RewriteRule ^media/(?:rainbow-gifts|chi-steppin)\.webp$ - [G,L,NC]
RewriteRule ^media/racine-lakefront\.webp$ /media/lakefront-sunrise.webp [R=301,L,NC]
RewriteRule ^(?:teaching|research)(?:/.*)?$ - [G,L,NC]
RewriteRule ^projects/(?:app-factory|student-software-portfolio|dj-tonya)(?:/index\.html|/)?$ - [G,L,NC]
RewriteRule ^media/dj-tonya\.webp$ - [G,L,NC]

# Preserve bookmarks to the original project filters.
RewriteCond %{QUERY_STRING} (?:^|&)group=(applications|community|web-design)(?:&|$)
RewriteRule ^projects/?$ /projects/category/%1/ [R=301,L,QSD]

# Apache serves the built directories through DirectoryIndex. Send explicit
# index.html links to the canonical directory URL.
RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.html[?\s]
RewriteRule ^((?:[a-zA-Z0-9_-]+/)*)index\.html$ /$1 [R=301,L]

ErrorDocument 410 /404.html
